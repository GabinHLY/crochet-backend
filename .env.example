# Copier ce fichier dans .env et renseigner la clé, côté serveur uniquement.
GEMINI_API_KEY=
# Mot de passe unique demandé à l’entrée du site. Utilisez une phrase longue et privée.
SITE_PASSWORD=
GEMINI_MODEL=gemini-3.5-flash
# Modèles essayés si le principal est saturé, séparés par des virgules.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# Nombre d'analyses lancées en parallèle ; leur médiane stabilise les mesures (1 à 5).
GEMINI_SAMPLES=5
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/crochet.sqlite
# Origines autorisées à appeler l’API depuis un autre domaine (front déployé à part), séparées par des virgules.
# Inutile en développement : le serveur Vite du front redirige /api vers ce serveur.
CORS_ORIGIN=
